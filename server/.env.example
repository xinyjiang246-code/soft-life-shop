# ===== 慢活小铺 · 后端配置样例 =====
# 复制成 .env 即可覆盖默认值。这里只放占位值，真实密钥绝不进代码库。
#   cp .env.example .env

# 运行环境：development | test | production
# ⚠️ production 下 CORS_ORIGINS 不允许写 *，且 DB_AUTO_MIGRATE 默认关闭
NODE_ENV=development

# 监听地址。只想本机可用就保持 127.0.0.1；
# 要让同一局域网 / 容器外部访问才改成 0.0.0.0（改之前先确认 CORS 白名单）
PORT=8787
HOST=127.0.0.1

# 优雅停机的兜底时长（毫秒）
SHUTDOWN_TIMEOUT_MS=10000

# SQLite 数据库文件。相对路径按 server/ 解析；也可以写绝对路径
DB_FILE=data/soft-life.db
DB_BUSY_TIMEOUT_MS=5000
# 启动时自动跑迁移（开发方便）。生产建议设 false，让迁移走独立发布步骤
DB_AUTO_MIGRATE=true

# CORS 白名单，逗号分隔。默认放行 Vite 开发服务器的两个地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 是否由本服务托管 admin 构建产物（admin/dist 存在时生效）
SERVE_ADMIN=true
# ADMIN_DIST_DIR=../admin/dist

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
